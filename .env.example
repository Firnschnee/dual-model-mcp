# Copy this file to .env and paste your real OpenRouter API key.
# Get one at https://openrouter.ai -> Settings -> Keys
OPENROUTER_API_KEY=your_actual_api_key_here

# --- Optional overrides (defaults shown) ---

# Comma-separated OpenRouter model IDs to query in parallel (2 or more)
#MODELS=anthropic/claude-fable-5.1,openai/gpt-6-astra

# Reasoning effort for all models: none, minimal, low, medium, high, xhigh, max
#REASONING_EFFORT=high

# ask_gpt tool: single cheap model for everyday second opinions
#ASK_GPT_MODEL=openai/gpt-5.6-sol
#ASK_GPT_EFFORT=xhigh
#ASK_GPT_MAX_TOKENS=32000

# Model used for the optional synthesis step (cheap model recommended)
#SYNTHESIS_MODEL=google/gemini-3.8-flash

# Max output tokens per model (reasoning tokens count against this)
#MAX_TOKENS=32000

# Sampling temperature (0-2). Only sent when set; OpenAI/Anthropic reasoning
# models ignore it anyway.
#TEMPERATURE=

# Per-request timeout in milliseconds
#REQUEST_TIMEOUT_MS=600000

# --- HTTP mode only (npm run start:http, for remote access / claude.ai) ---

# Required in HTTP mode: secret URL path segment, min. 16 chars.
# Generate e.g. with: openssl rand -hex 24
#MCP_PATH_SECRET=

# Bind address and port (keep 127.0.0.1 behind a reverse proxy)
#MCP_HTTP_HOST=127.0.0.1
#MCP_HTTP_PORT=3777
